# Raw data IS committed for this project: 10k rows / 1 MB, and a fresh clone
# must be able to reproduce the results table without an external download.
# Derived tables are regenerated by scripts/run_experiment.py.
data/processed/*
!data/**/.gitkeep

# Except the results tables. These are the project's findings, they are small,
# and the results notebook reads them, so a fresh clone must have them.
!data/processed/results_*.csv

# Environment
.venv/
venv/
__pycache__/
*.py[cod]
.python-version

# Notebooks
.ipynb_checkpoints/

# macOS
.DS_Store

# Tooling
.pytest_cache/
.ruff_cache/
*.egg-info/
